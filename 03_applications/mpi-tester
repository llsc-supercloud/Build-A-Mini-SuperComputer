#include <mpi.h>
int main(int argc, char *argv[]) {    int comm_size, comm_rank;
    MPI_Init( &argc, &argv );
    MPI_Comm_size( MPI_COMM_WORLD, &comm_size );
    MPI_Comm_rank( MPI_COMM_WORLD, &comm_rank );
    if (0 == comm_rank) printf(“Total %d MPI ranks.\n”, comm_size );
    MPI_Finalize();
    return 0;
}
